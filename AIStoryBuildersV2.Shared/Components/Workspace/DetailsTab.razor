@* Details tab (UI-Behavior-Spec §10, V1 StoryEdit.razor:40-111). *@
@using AIStoryBuildersV2.Shared.Knowledge
@inject AIStoryBuildersService Svc
@inject DialogService Dialogs
@inject NotificationService Notify
@inject IFileExportService Export
@inject NavigationManager Nav
@inject LogService Log
@inject IStoryPersistence Persist

<h3 class="asb-ws-sec">Story details</h3>
<div class="asb-field">
    <label>Story Title:</label>
    <div class="asb-ro">@Story.Title</div>
</div>
<div class="asb-field">
    <label for="d-style">Style:</label>
    <RadzenDropDown id="d-style" TValue="string" Data="@Styles" @bind-Value="Story.Style" Style="width:100%" Disabled="busy" />
</div>
<div class="asb-field">
    <label for="d-syn">Synopsis:</label>
    <RadzenTextArea id="d-syn" Rows="5" MaxLength="1000" @bind-Value="Story.Synopsis" Style="width:100%" Disabled="busy" />
</div>
<RadzenPanel AllowCollapse="true" Collapsed="true" class="asb-collapse">
    <HeaderTemplate><span class="asb-collapse-h">System Message</span></HeaderTemplate>
    <ChildContent>
        <RadzenTextArea Rows="5" MaxLength="1000" @bind-Value="Story.Theme" Style="width:100%" Disabled="busy" aria-label="System Message" />
    </ChildContent>
</RadzenPanel>
<RadzenPanel AllowCollapse="true" Collapsed="true" class="asb-collapse">
    <HeaderTemplate><span class="asb-collapse-h">World Facts</span></HeaderTemplate>
    <ChildContent>
        <RadzenTextArea Rows="8" MaxLength="2000" @bind-Value="Story.WorldFacts" Style="width:100%" Disabled="busy" aria-label="World Facts"
                        Placeholder="Enter persistent world-building facts, one per line (e.g., Magic is illegal in the Northern Kingdom)" />
    </ChildContent>
</RadzenPanel>

<div class="asb-actions asb-mt">
    <RadzenButton Text="Save" Icon="save" ButtonStyle="ButtonStyle.Success" Disabled="busy" Click="SaveAsync" />
    <RadzenButton Text="Save Word Doc" Icon="print" ButtonStyle="ButtonStyle.Primary" Disabled="busy" Click="WordAsync" />
    <RadzenButton Text="Export Project" Icon="save_alt" ButtonStyle="ButtonStyle.Primary" Disabled="busy" Click="ExportAsync" />
    <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Disabled="busy" Click="DeleteAsync" />
    <RadzenButton Text="Re-load Story" Icon="sync" ButtonStyle="ButtonStyle.Warning" Disabled="busy" Click="ReloadAsync" />
</div>

@* Writing voice (Lexical-Fingerprint-Plan §5.2, §6.6) *@
<section class="asb-voice asb-mt" aria-labelledby="d-voice-h">
    <h3 class="asb-ws-sec" id="d-voice-h">Writing voice</h3>
    @if (fingerprint.Status == FingerprintStatus.Ok)
    {
        <p class="asb-sub">This story writes in the voice below. To change it, make a new fingerprint at @ToolLink and click Replace.</p>
        <div class="asb-subcard asb-voice-card">
            <span class="mi asb-voice-icon" aria-hidden="true">fingerprint</span>
            <div class="asb-voice-text">
                <b>@fingerprint.Name</b>
                <div class="asb-note asb-voice-profile" title="@fingerprint.Fingerprint?.CondensedProfile">@ProfilePreview</div>
                @if (fingerprint.UploadedUtc is { } uploaded)
                {
                    <div class="asb-note">Uploaded @uploaded.ToLocalTime().ToString("d")</div>
                }
            </div>
        </div>
    }
    else
    {
        <p class="asb-sub">
            A lexical fingerprint is a short profile of how you write: sentence rhythm, word choice, punctuation, point of view, and the
            habits you avoid. It is built from a sample of your own prose. When this story has one, the AI writes new paragraphs and Story
            Chat edits in your voice. To get one, open @ToolLink, upload a writing sample (PDF, Word or Markdown, under 5,000 words), and
            download the .json file it gives you. Then come back here and click Upload fingerprint.
        </p>
        @if (fingerprint.Status == FingerprintStatus.Invalid)
        {
            <div class="asb-subcard asb-voice-card" role="alert">
                <span class="mi asb-voice-icon asb-err" aria-hidden="true">error_outline</span>
                <div class="asb-voice-text">This story's fingerprint file can't be read, so the AI isn't using it. @fingerprint.Error</div>
            </div>
        }
    }
    <div class="asb-actions">
        <label class="rz-button rz-button-md rz-variant-filled rz-primary rz-shade-default asb-file-button @(busy ? "rz-state-disabled" : "")">
            <span class="rz-button-box"><i class="notranslate rz-button-icon-left rzi">upload_file</i><span class="rz-button-text">@(fingerprint.Status == FingerprintStatus.None ? "Upload fingerprint" : "Replace")</span></span>
            <InputFile @key="fingerprintKey" accept=".json,application/json" OnChange="UploadFingerprintAsync" disabled="@busy" />
        </label>
        @if (fingerprint.Status != FingerprintStatus.None)
        {
            <RadzenButton Text="Remove" Icon="delete" ButtonStyle="ButtonStyle.Danger" Disabled="busy" Click="RemoveFingerprintAsync" />
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public Story Story { get; set; } = default!;
    [Parameter] public EventCallback OnDeleted { get; set; }

    /// <summary>V1's style list and order.</summary>
    public static readonly string[] Styles = ["Drama", "Sci-Fi", "Romance", "Comedy", "Fantasy", "Mystery", "Thriller", "Children", "Young Adult", "Action", "Crime", "Dystopian", "Horror"];

    bool busy;
    StoryFingerprint fingerprint = StoryFingerprint.NoneValue;
    string? fingerprintTitle;
    int fingerprintKey;

    RenderFragment ToolLink => @<span><a href="@LexicalFingerprintDefaults.ToolUrl" target="_blank" rel="noopener noreferrer">Get your lexical fingerprint</a> (free, external site)</span>;

    string ProfilePreview => fingerprint.Fingerprint?.CondensedProfile is { } p && p.Length > 200 ? p[..200].TrimEnd() + "…" : fingerprint.Fingerprint?.CondensedProfile ?? "";

    /// <summary>The name in confirms: "{Name}" in quotes, or "the current fingerprint" (§6.6).</summary>
    string OldName => string.IsNullOrEmpty(fingerprint.Name) ? "the current fingerprint" : $"\"{fingerprint.Name}\"";

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(Story.Style)) Story.Style = "Drama";
        // Only when the story changes: WASM saves re-render the workspace, and a reload each time would re-log an invalid file (§5.2).
        if (Story.Title != fingerprintTitle) await LoadFingerprintAsync();
    }

    async Task LoadFingerprintAsync()
    {
        fingerprintTitle = Story.Title;
        fingerprint = await Svc.GetLexicalFingerprintAsync(Story.Title, logInvalid: true);
    }

    async Task UploadFingerprintAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > LexicalFingerprintDefaults.MaxFileBytes)
        {
            fingerprintKey++;
            Notify.Notify(NotificationSeverity.Error, "Fingerprint", LexicalFingerprintParser.TooLarge, 4000);
            return;
        }

        busy = true;
        var saved = false;
        try
        {
            // Read the file before re-rendering: a new key replaces the InputFile its stream reads through.
            byte[] bytes;
            using (var buffer = new MemoryStream())
            {
                await file.OpenReadStream(LexicalFingerprintDefaults.MaxFileBytes).CopyToAsync(buffer);
                bytes = buffer.ToArray();
            }

            var parsed = LexicalFingerprintParser.Parse(bytes, file.Name);
            if (!parsed.Ok)
            {
                Notify.Notify(NotificationSeverity.Error, "Fingerprint", parsed.Error, 6000);
                return;
            }
            if (fingerprint.Status != FingerprintStatus.None &&
                await Dialogs.Confirm($"Replace {OldName} with \"{parsed.SuggestedName}\"?", "Replace Fingerprint",
                    new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" }) != true)
                return;

            var result = await Svc.SaveLexicalFingerprintAsync(Story.Title, bytes, file.Name);
            if (result.Status != FingerprintStatus.Ok)
            {
                Notify.Notify(NotificationSeverity.Error, "Fingerprint", result.Error, 6000);
                return;
            }
            saved = true;
            await Persist.FlushAsync(Story.Title);
            Notify.Notify(NotificationSeverity.Success, "Fingerprint", "Saved. New AI writing will use this voice.", 4000);
        }
        catch (Exception ex)
        {
            Fail(ex);
        }
        finally
        {
            busy = false;
            fingerprintKey++;   // a fresh InputFile so the same file can be picked again
            // Reload even when the flush failed: the file is in MEMFS and the AI uses it in this tab (§6.6).
            if (saved) await LoadFingerprintAsync();
        }
    }

    async Task RemoveFingerprintAsync()
    {
        if (await Dialogs.Confirm($"Remove {OldName} from this story? New AI writing will stop using it.", "Remove Fingerprint",
                new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" }) != true) return;
        busy = true;
        try
        {
            if (await Svc.RemoveLexicalFingerprintAsync(Story.Title))
            {
                await Persist.FlushAsync(Story.Title);
                Notify.Notify(NotificationSeverity.Success, "Fingerprint", "Removed.", 3000);
            }
            else
            {
                Notify.Notify(NotificationSeverity.Info, "Fingerprint", "There was no fingerprint to remove.", 3000);
            }
        }
        catch (Exception ex)
        {
            Fail(ex);
        }
        finally
        {
            busy = false;
            await LoadFingerprintAsync();
        }
    }

    void Fail(Exception ex)
    {
        if (ex is StorageQuotaExceededException)
        {
            // The workspace banner offers Retry and Export Project.
            Notify.Notify(NotificationSeverity.Error, "Browser storage is full", "Your latest changes are kept in this tab but are not saved.", 6000);
            Log.WriteToLog(ex.Message);
            return;
        }
        Notify.Notify(NotificationSeverity.Error, "Error", ex.Message, 4000);
        Log.WriteToLog(ex.Message);
    }

    async Task RunAsync(Func<Task> action)
    {
        busy = true;
        try { await action(); }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }

    Task SaveAsync() => RunAsync(async () =>
    {
        await Svc.UpdateStoryAsync(Story);
        Notify.Notify(NotificationSeverity.Success, "Story", "Updated!", 2000);
    });

    Task WordAsync() => RunAsync(async () =>
    {
        using var stream = new MemoryStream(Svc.ExportWordDocument(Story));
        if (await Export.SaveAsync($"{Story.Title}_{DateTime.Now:yyyy-MM-dd_HH-mm-ss}.docx", stream,
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document"))
            Notify.Notify(NotificationSeverity.Success, "Saved", "The file was saved successfully.", 4000);
    });

    Task ExportAsync() => RunAsync(async () =>
    {
        Notify.Notify(NotificationSeverity.Info, "Exporting", "Story...", 2000);
        using var stream = new MemoryStream(Svc.ExportProject(Story));
        if (await Export.SaveAsync($"{Story.Title}_{DateTime.Now:yyyy-MM-dd_HH-mm-ss}.stybld", stream, "application/zip"))
            Notify.Notify(NotificationSeverity.Success, "Saved", "The file was saved successfully.", 4000);
    });

    async Task DeleteAsync()
    {
        if (await Dialogs.Confirm("Are you sure?", "Delete Story", new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" }) != true) return;
        await RunAsync(async () =>
        {
            await Svc.DeleteStoryAsync(Story.Title);
            await OnDeleted.InvokeAsync();
            Notify.Notify(NotificationSeverity.Success, "Deleted", $"{Story.Title} was deleted.", 4000);
            Nav.NavigateTo("");
        });
    }

    async Task ReloadAsync()
    {
        if (await Dialogs.Confirm("This will regenerate all vector embeddings and rebuild the Knowledge Graph. Continue?", "Re-load Story",
                new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" }) != true) return;
        busy = true;
        try
        {
            await Dialogs.OpenAsync<ReloadProgressDialog>("Re-load Story", new Dictionary<string, object?> { ["Story"] = Story },
                new DialogOptions { Width = "440px", ShowClose = false, CloseDialogOnEsc = false, CloseDialogOnOverlayClick = false });
        }
        finally
        {
            busy = false;
        }
    }
}
